# Container versions
N8N_VERSION=2.38.7
POSTGRES_VERSION=18

# Public URL served by the external reverse proxy
N8N_HOST=n8n.example.com
N8N_EDITOR_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/

# Local-only health endpoint and shared reverse-proxy network
N8N_LOCAL_PORT=5678
PROXY_NETWORK=public-proxy

# Generate independent random values. Never commit the real .env file.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
RUNNERS_AUTH_TOKEN=replace-with-a-long-random-value
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=replace-with-a-long-random-value

# Runtime settings
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
N8N_LOG_LEVEL=info
