        "returnAll": true
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        580,
        0
      ],
      "id": "00000000-0000-4000-8000-000000002009",
      "name": "Get Active Alerts",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const alerts=$items('Get Active Alerts').map(i=>i.json).filter(x=>x.alert_id);const msgs=$items('Get Candidate Messages').map(i=>i.json);const allowed=new Set($input.all().map(i=>i.json).filter(s=>s.status==='active'&&s.chat_id&&s.channel_username).map(s=>String(s.chat_id)+':'+String(s.channel_username).toLowerCase()));const out=[];for(const a of alerts)for(const m of msgs){const channel=String(m.channel_username||'').toLowerCase();if(!allowed.has(String(a.chat_id)+':'+channel))continue;if(a.channel_username&&a.channel_username!=='*'&&String(a.channel_username).toLowerCase()!==channel)continue;if(!String(m.text||'').toLocaleLowerCase('fa').includes(String(a.keyword||'').toLocaleLowerCase('fa')))continue;out.push({json:{delivery_key:a.alert_id+':'+channel+':'+m.message_id,alert_id:a.alert_id,chat_id:String(a.chat_id),channel_username:channel,message_id:m.message_id,keyword:a.keyword,message_url:m.message_url,summary:m.summary||String(m.text||'').slice(0,240),status:'pending',created_at:new Date().toISOString()}});}return out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        0
      ],
      "id": "00000000-0000-4000-8000-000000002010",
      "name": "Match Alerts"
    },
    {
